POSTGRES_PASSWORD=change-me
AQUA_DB=aqua.db
# --- RED-alert SMS / WhatsApp (only the CRITICAL level ever sends) ---
ALERT_PHONES=9XXXXXXXXX                              # only used by provider=webhook; ntfy goes to the topic
ALERT_PROVIDER=ntfy                                 # ntfy (free phone push) | webhook | log (dry run)
NTFY_TOPIC=aquaforecast-yourname-4821               # same name you subscribe to in the ntfy phone app; keep it unguessable
#ALERT_WEBHOOK_URL=                                 # provider=webhook: receives JSON {to, message, source}
#ALERT_WEBHOOK_TOKEN=
ALERT_ADMIN_TOKEN=                                  # long random string; enables the admin-only TEST send
ALERT_REPEAT_HOURS=24                               # re-send interval while a city stays red

# --- CWC weekly reservoir bulletin (PDF link; Google Drive share links work if shared "Anyone with the link") ---
#CWC_BULLETIN_URL=
CWC_CHECK_HOURS=6
