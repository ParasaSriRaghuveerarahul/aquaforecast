POSTGRES_PASSWORD=change-me
AQUA_DB=aqua.db
# --- RED-alert SMS / WhatsApp (only the CRITICAL level ever sends) ---
ALERT_PHONES=9XXXXXXXXX,9XXXXXXXXX,9XXXXXXXXX      # comma separated; 10-digit Indian mobiles or +E.164
ALERT_PROVIDER=log                                  # log (dry run) | twilio_sms | twilio_whatsapp | webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                                        # +1555... for SMS; +14155238886 (sandbox) for WhatsApp
#TWILIO_MESSAGING_SERVICE_SID=                      # alternative to TWILIO_FROM (SMS)
#ALERT_WEBHOOK_URL=                                 # provider=webhook: receives JSON {to, message, source}
#ALERT_WEBHOOK_TOKEN=
ALERT_ADMIN_TOKEN=                                  # long random string; enables the admin-only TEST send
ALERT_REPEAT_HOURS=24                               # re-send interval while a city stays red
